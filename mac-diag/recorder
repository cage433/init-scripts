#!/bin/zsh -f
# mac-diag-recorder - record this Mac's state, to help diagnose occasional freezes.
# Reads local state only: nothing is sent off the machine, and nothing needs root.
#
#   mac-diag-recorder                 same as --status
#   mac-diag-recorder --status [--days N]
#                                     summarise what has been recorded (default 1 day)
#   mac-diag-recorder --install       build the helpers, write and load the LaunchAgents
#   mac-diag-recorder --uninstall     unload and remove the LaunchAgents; keeps the data
#   mac-diag-recorder --snapshot      append one snapshot (run by launchd every minute)
#   mac-diag-recorder --events        stream selected system log events (run by launchd)
#
# Three LaunchAgents write to ~/mac-diag/recorder, one file per kind per day:
#   snap-YYYY-MM-DD.log    a snapshot every 60 s: threads, CPU, memory, thermal,
#                          interfaces, routes, DNS, VPN, network extensions, Wi-Fi,
#                          router ping and DNS lookup times, pfctl
#   events-YYYY-MM-DD.log  as they happen: primary-interface changes, Wi-Fi link and
#                          datapath errors, VPN/proxy session changes, configd network changes
#   stalls-YYYY-MM-DD.log  each time the stall detector could not run for more than
#                          0.5 s (it wakes 4 times a second), or WindowServer took
#                          more than 0.5 s to answer it (it asks once a second)
# Earlier days are gzipped, and files older than 7 days are deleted.
#
# Each snapshot section header is written before its command runs, so if a command
# blocks (as configd did in the October 2026 freezes) the snapshot ends at that
# header, which shows where the system was stuck.

zmodload zsh/datetime
setopt pipe_fail

SELF=${0:A}
HERE=${SELF:h}
DATA=$HOME/mac-diag/recorder
HELPER_DIR=$HOME/.local/libexec/mac-diag
HELPERS=(wifi-signal stall-detector)
LINK=$HOME/bin/mac-diag-recorder
AGENTS_DIR=$HOME/Library/LaunchAgents
SNAP_LABEL=com.cage433.mac-diag-recorder
EVENTS_LABEL=com.cage433.mac-diag-events
STALLS_LABEL=com.cage433.mac-diag-stalls
LABELS=($SNAP_LABEL $EVENTS_LABEL $STALLS_LABEL)
KEEP_DAYS=7
STEP_TIMEOUT=10          # seconds; a step taking longer is killed and marked with !!

# What --events keeps from the system log. The kernel Wi-Fi errors and the
# nesessionmanager interface changes are the messages seen before the October freezes.
# The kernel's "Datapath timeout" lines come from the driver for Apple's N1 Wi-Fi chip
# only (a Broadcom chip logs nothing comparable); airportd's Wi-Fi faults (DNS
# failure, slow Wi-Fi) and DatapathStall analyses are logged whatever the chip, so
# they compare Macs with different chips.
EVENT_PREDICATE='
  (process == "nesessionmanager" AND (eventMessage CONTAINS "interface changed"
      OR ((eventMessage CONTAINS "Entering state" OR eventMessage CONTAINS "status changed")
          AND NOT eventMessage BEGINSWITH "NESMPathControllerSession")))
  OR (process == "kernel" AND (eventMessage CONTAINS "Datapath timeout"
      OR eventMessage CONTAINS "Link Down on en" OR eventMessage CONTAINS "Link Up on en"))
  OR (process == "configd" AND eventMessage BEGINSWITH "network changed")
  OR (process == "airportd" AND (eventMessage CONTAINS "faultEventDetected"
      OR eventMessage CONTAINS "for reason DatapathStall"))'

usage() { sed -n '2,/^$/{s/^# \{0,1\}//;p;}' $SELF }

# ---------------------------------------------------------------------------
# snapshot

# Runs a command with a time limit. The alarm survives exec, so the command itself
# receives SIGALRM; a process stuck in the kernel dies when it next returns.
limit() {
  perl -e 'alarm shift; exec @ARGV or die "exec: $!\n"' $STEP_TIMEOUT "$@"
  local rc=$?
  (( rc == 0 )) || print -u2 "!! $1 exited $rc${${(M)rc:#142}:+ (timed out after ${STEP_TIMEOUT}s)}"
  return rc
}

section() { print "## $1" }

snapshot() {
  PATH=/usr/bin:/bin:/usr/sbin:/sbin
  mkdir -p $DATA
  local today=$(strftime %Y-%m-%d $EPOCHSECONDS)
  local out=$DATA/snap-$today.log
  exec >>$out 2>&1
  local start=$EPOCHREALTIME

  print "=== $(strftime '%Y-%m-%dT%H:%M:%S%z' $EPOCHSECONDS) load=$(sysctl -n vm.loadavg)"

  # One process listing, reused by the thread, VPN and pfctl sections.
  local procs
  procs=$(limit ps -axo pid=,comm=)

  section "threads (top 15)"
  # ps -M prints one line per thread: the process's first line starts with the user
  # name (pid in field 2), the rest start with the pid.
  limit ps -axM | awk '
    FNR == NR { l = $0; sub(/^ +/, "", l); p = l; sub(/ .*/, "", p)
                c = l; sub(/^[0-9]+ +/, "", c); sub(/.*\//, "", c); name[p] = c; next }
    FNR == 1  { next }
    { pid = ($1 ~ /^[0-9]+$/) ? $1 : $2; count[pid]++ }
    END { for (p in count) printf "%5d %6d %s\n", count[p], p, name[p] }' <(print -r -- "$procs") - | sort -rn | head -15

  section "cpu (top 8, % of one core, decaying average)"
  limit ps -axo %cpu=,pid=,comm= | sort -rn | head -8 | awk '{ c = $0; sub(/^ *[0-9.]+ +[0-9]+ +/, "", c); sub(/.*\//, "", c); printf "%6s %6d %s\n", $1, $2, c }'

  section "memory"
  local free swap compressed level
  free=$(limit memory_pressure -Q | awk -F': ' '/percentage/ { print $2 }')
  level=$(sysctl -n kern.memorystatus_vm_pressure_level)
  swap=$(sysctl -n vm.swapusage | awk '{ print $6 }')
  compressed=$(limit vm_stat | awk '/occupied by compressor/ { gsub(/\./, "", $NF); printf "%.0f", $NF * 16384 / 1048576 }')
  print "free=$free pressure=${${${level/#1/normal}/#2/warn}/#4/critical} swap_used=$swap compressor=${compressed}M"

  section "thermal"
  limit pmset -g therm | sed -e 's/^Note: //' -e '/^$/d'

  section "interfaces (up and active, plus utun)"
  limit ifconfig -a | awk '
    function flush() {
      if (name != "" && up && (status == "active" || name ~ /^utun/ || (status == "" && addrs != "")))
        printf "%-8s %-8s mtu %s%s\n", name, (status == "" ? "-" : status), mtu, addrs
    }
    /^[a-z]/ { flush(); name = $1; sub(/:$/, "", name); up = ($0 ~ /<UP/); status = ""; addrs = ""
               mtu = $0; sub(/.*mtu /, "", mtu); next }
    $1 == "inet"    { addrs = addrs " " $2 }
    $1 == "inet6"   { a = $2; sub(/%.*/, "", a); addrs = addrs " " a }
    $1 == "status:" { status = $2 }
    END { flush() }'

  section "default routes"
  limit netstat -rn -f inet  | awk '$1 == "default" || $1 ~ /^(0|128(\.0)*)\/1$/'
  limit netstat -rn -f inet6 | awk '$1 == "default" || $1 ~ /^::\/1$/ || $1 ~ /^8000::\/1$/'

  section "dns resolvers"
  limit scutil --dns | awk '
    function flush() { if (ns != "") printf "%-8s %s ns=%s%s%s\n", scope, r, ns, (dom == "" ? "" : " domain=" dom), (ifn == "" ? "" : " if=" ifn) }
    /^DNS configuration \(for scoped/ { flush(); r = ""; scope = "scoped"; next }
    /^DNS configuration/              { scope = "default"; next }
    /^resolver #/         { flush(); r = $1 $2; ns = ""; dom = ""; ifn = ""; next }
    $1 == "domain"        { dom = $3 }
    $1 == "nameserver[0]" { ns = $3; next }
    $1 ~ /^nameserver\[/  { ns = ns "," $3 }
    $1 == "if_index"      { ifn = $4; gsub(/[()]/, "", ifn) }
    END { flush() }'

  section "vpn"
  limit scutil --nc list | sed 1d
  print -r -- "$procs" | awk '{ c = $0; sub(/^ *[0-9]+ +/, "", c) }
    tolower(c) ~ /amnezia|tun2socks|openvpn|wireguard|wg-go|protonvpn|xray|cloak|tailscale/ { sub(/^ +/, ""); print "proc " $0 }'

  section "network extensions"
  # Network and driver system extensions, with their state; content filters,
  # transparent proxies and VPN tunnels all arrive as network extensions.
  limit systemextensionsctl list | awk -F'\t' '$1 == "*" || $1 == "" && NF >= 6 { print $4 " - " $5 " " $6 }'

  section "wifi"
  if [[ -x $HELPER_DIR/wifi-signal ]]; then
    limit $HELPER_DIR/wifi-signal
  else
    print "wifi: unavailable (helper not built - run mac-diag-recorder --install)"
  fi

  section "latency"
  # Whether the network is actually slow, as opposed to the driver logging datapath
  # timeouts. Ten pings to the Wi-Fi router over 2 s (bound to en0, so a VPN tunnel
  # is bypassed) measure the Wi-Fi hop alone; one DNS lookup through the system's
  # resolver measures the path apps use, VPN included. Neither goes beyond the
  # router and the configured DNS server. ping and dig limit their own run time
  # (4 s and 2 s), and a failure here is a measurement, not a recorder error.
  local gw pingout dnsout
  gw=$(ipconfig getoption en0 router 2>/dev/null)
  if [[ -n $gw ]]; then
    pingout=$(ping -q -n -c 10 -i 0.2 -t 4 -b en0 $gw 2>&1)
    print -r -- "$pingout" | awk -v gw=$gw '
      / packets transmitted/ { sent = $1; recv = $4 }
      /^round-trip/          { split($4, r, "/"); rtt = sprintf(" rtt_ms=%.1f/%.1f/%.1f", r[1], r[2], r[3]) }
      END { printf "router: gw=%s sent=%d received=%d%s\n", gw, sent, recv, rtt }'
  else
    print "router: no Wi-Fi router"
  fi
  dnsout=$(dig +tries=1 +time=2 apple.com A 2>&1)
  print -r -- "$dnsout" | awk '
    /status:/       { st = $6; sub(/,$/, "", st) }
    /Query time:/   { ms = $4 }
    /^;; SERVER:/   { split($3, s, "#"); srv = s[1] }
    END { if (ms == "") print "dns: timeout"; else printf "dns: server=%s status=%s ms=%d\n", srv, st, ms }'

  section "pfctl"
  # Without root there is no record of past pfctl runs: it writes nothing to the
  # unified log. Two proxies: pfctl running at this instant, and pf rule files
  # changed in the last minute.
  local running changed
  running=$(print -r -- "$procs" | awk '$2 ~ /(^|\/)pfctl$/ { printf " %s", $1 }')
  changed=$(find /etc/pf.conf /etc/pf.anchors "/Library/Application Support/AmneziaVPN/pf" -mtime -60s 2>/dev/null | tr '\n' ' ')
  print "running_now=${running:-no} rule_files_changed_last_60s=${changed:-none}"

  printf "## done in %.0fms\n" $(( (EPOCHREALTIME - start) * 1000 ))

  # Housekeeping: compress earlier days, delete anything older than KEEP_DAYS.
  local f
  for f in $DATA/{snap,events,stalls}-*.log(N); do
    [[ ${f:t:r} == *-$today ]] || gzip -q $f
  done
  find $DATA -maxdepth 1 \( -name 'snap-*.log*' -o -name 'events-*.log*' -o -name 'stalls-*.log*' \) \
    -mtime +$KEEP_DAYS -delete
}

# ---------------------------------------------------------------------------
# events

events() {
  PATH=/usr/bin:/bin:/usr/sbin:/sbin
  mkdir -p $DATA
  print "$(strftime '%Y-%m-%d %H:%M:%S' $EPOCHSECONDS).000 -- event stream started" >> $DATA/events-$(strftime %Y-%m-%d $EPOCHSECONDS).log
  # One file per day, named from each line's own date. Lines that don't start with
  # a date (the stream's header) are dropped.
  /usr/bin/log stream --style compact --predicate "$EVENT_PREDICATE" | awk -v dir=$DATA '
    $1 ~ /^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ {
      f = dir "/events-" $1 ".log"
      if (f != cur) { if (cur != "") close(cur); cur = f }
      print >> cur; fflush(cur)
    }'
}

# ---------------------------------------------------------------------------
# install / uninstall

build_helpers() {
  local name helper src
  for name in $HELPERS; do
    helper=$HELPER_DIR/$name
    src=$HERE/$name.swift
    if [[ -x $helper && ! $src -nt $helper ]]; then
      print "$name up to date"
      continue
    fi
    if ! xcrun --find swiftc >/dev/null 2>&1; then
      print "swiftc not found - install the Command Line Tools (xcode-select --install)."
      print "Wi-Fi readings and the stall detector are unavailable until then."
      return 1
    fi
    mkdir -p $HELPER_DIR
    if xcrun swiftc -O -o $helper $src; then
      print "built ${helper/$HOME/~}"
    else
      print "building $name failed"
    fi
  done
}

# write_plist label process-type keep-alive|interval:N program args...
# launchd expands neither ~ nor $HOME, so the paths are written out in full.
write_plist() {
  local label=$1 ptype=$2 run=$3; shift 3
  local plist=$AGENTS_DIR/$label.plist arg schedule
  if [[ $run == keep-alive ]]; then
    schedule="    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>"
  else
    schedule="    <key>StartInterval</key>
    <integer>${run#interval:}</integer>"
  fi
  mkdir -p $AGENTS_DIR $DATA
  {
    print '<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>'$label'</string>
    <key>ProgramArguments</key>
    <array>'
    for arg; do print "        <string>$arg</string>"; done
    print "    </array>
$schedule
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>$ptype</string>"
    [[ $ptype == Background ]] && print "    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>"
    print "    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>$DATA/launchd-errors.log</string>
</dict>
</plist>"
  } > $plist
  plutil -lint -s $plist
}

loaded() { launchctl print gui/$UID/$1 >/dev/null 2>&1 }

install() {
  if [[ ! -x $LINK || ${LINK:A} != $SELF ]]; then
    print "${LINK/$HOME/~} must link to $SELF - run doctor --fix first."
    return 1
  fi
  build_helpers
  # Let a snapshot in progress finish, or unloading kills it half-written.
  integer waited=0
  while [[ $(launchctl print gui/$UID/$SNAP_LABEL 2>/dev/null) == *"state = running"* ]] && (( waited++ < 30 )); do
    sleep 0.5
  done
  local label
  for label in $LABELS; do loaded $label && launchctl bootout gui/$UID/$label; done
  write_plist $SNAP_LABEL   Background  interval:60 $LINK --snapshot || return 1
  write_plist $EVENTS_LABEL Background  keep-alive  $LINK --events   || return 1
  # The stall detector must not be throttled, or throttling would pass for stalls.
  write_plist $STALLS_LABEL Interactive keep-alive  $HELPER_DIR/stall-detector $DATA || return 1
  for label in $LABELS; do
    if [[ $label == $STALLS_LABEL && ! -x $HELPER_DIR/stall-detector ]]; then
      print "not loading $label: stall-detector is not built"
      continue
    fi
    launchctl bootstrap gui/$UID $AGENTS_DIR/$label.plist && print "loaded $label"
  done
  print "recording to ${DATA/$HOME/~}"
}

uninstall() {
  local label
  for label in $LABELS; do
    loaded $label && launchctl bootout gui/$UID/$label
    rm -f $AGENTS_DIR/$label.plist
  done
  print "LaunchAgents removed. Recorded data left in ${DATA/$HOME/~}"
}

# ---------------------------------------------------------------------------
# status

agent_status() {
  print "recorder"
  local label info runs rc state
  for label in $LABELS; do
    if loaded $label; then
      info=$(launchctl print gui/$UID/$label)
      runs=$(print -r -- "$info" | awk -F' = ' '/^\truns/ { print $2 }')
      rc=$(print -r -- "$info" | awk -F' = ' '/^\tlast exit code/ { print $2 }')
      state=$(print -r -- "$info" | awk -F' = ' '/^\tstate/ { print $2; exit }')
      printf "  %-30s loaded, %s (runs: %s, last exit: %s)\n" ${label#com.cage433.} $state $runs $rc
    elif [[ -e $AGENTS_DIR/$label.plist ]]; then
      printf "  %-30s NOT LOADED, though its plist is present - run --install\n" ${label#com.cage433.}
    else
      printf "  %-30s not installed - run --install\n" ${label#com.cage433.}
    fi
  done
  local name
  for name in $HELPERS; do
    if [[ ! -x $HELPER_DIR/$name ]]; then
      printf "  %-30s not built - run --install\n" $name
    elif [[ $HERE/$name.swift -nt $HELPER_DIR/$name ]]; then
      printf "  %-30s out of date - run --install\n" $name
    fi
  done
  [[ -s $DATA/launchd-errors.log ]] && print "  launchd errors: see ${DATA/$HOME/~}/launchd-errors.log"
  print "  data                           ${DATA/$HOME/~} ($(du -sh $DATA 2>/dev/null | cut -f1 | tr -d ' '))"
}

status() {
  local days=1
  [[ ${1:-} == --days ]] && days=${2:?--days needs a number}
  agent_status
  print
  # Without the Command Line Tools /usr/bin/python3 is a stub that only offers to install them.
  if ! xcode-select -p >/dev/null 2>&1; then
    print "The summary needs the Command Line Tools for python3: xcode-select --install"
    return 1
  fi
  local running=0
  [[ $(launchctl print gui/$UID/$SNAP_LABEL 2>/dev/null) == *"state = running"* ]] && running=1
  pmset -g log 2>/dev/null | grep -E '^20[0-9-]+ [0-9:]+ [+-][0-9]{4} (Sleep|Wake|DarkWake|Start) ' |
    /usr/bin/python3 -I $HERE/status.py --days $days --data $DATA --running $running --power -
}

# ---------------------------------------------------------------------------

case ${1:-} in
  --snapshot)   snapshot ;;
  --events)     events ;;
  ""|--status)  shift 2>/dev/null; status "$@" ;;
  --install)    install ;;
  --uninstall)  uninstall ;;
  -h|--help)    usage ;;
  *)            usage >&2; exit 2 ;;
esac
