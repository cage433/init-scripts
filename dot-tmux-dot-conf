# act like vim
set-option -g display-time 120




setw -g mode-keys vi

# Scrollback. The 2000-line default fills up inside a single Claude Code session
# (tool output is verbose), so anything older is discarded before you can reach it.
set -g history-limit 100000

# Let the wheel scroll into copy-mode. In iTerm2, hold Option while dragging to
# bypass tmux mouse reporting and make a native selection instead.
set -g mouse on
set -g base-index 1

# True colour: tell tmux the outer terminal (iTerm2) supports 24-bit colour, so it
# doesn't downgrade to 256 and oversaturate muted themes like Solarized.
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-256color:RGB"


# act like GNU screen
unbind C-b
set -g prefix C-a

# Don't prompt before killng pane
unbind x
bind x kill-pane 

# Move to beginning of line
bind a send-prefix

set -g status on

unbind r
bind r source-file ~/.tmux.conf


set -g display-time 2000
set -g renumber-windows on

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Resize panes with vim motions (repeatable: keep tapping after the prefix)
bind -r C-h resize-pane -L 5
bind -r C-j resize-pane -D 5
bind -r C-k resize-pane -U 5
bind -r C-l resize-pane -R 5

# New sessions open in the same directory as the current pane
bind c new-window -c "#{pane_current_path}"

# Sort the session list by name rather than creation order
bind s choose-tree -Zs -O name

# Pane splits should open to the same path as the current pane
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"

unbind t
bind t send-keys -t 1 "C-l" "dune test" Enter

unbind t
bind t send-keys -t 1 "C-l" "pdflatex split-fx.tex" Enter

# Name the terminal window after the tmux session, so iTerm2's Window menu is navigable
set -g set-titles on
set -g set-titles-string "#S"

# Profiles that ignore the terminal-set title need the name pushed in over AppleScript
set-hook -g client-attached        'run-shell -b "~/repos/init-scripts/bin/iterm-name --tty #{client_tty}"'
set-hook -g client-session-changed 'run-shell -b "~/repos/init-scripts/bin/iterm-name --tty #{client_tty}"'

# Sessions are named "<node> (<branch words>)" by iterm-name. The status bar shows the node, then
# reads the branch from the session's worktree on every refresh, so a checkout mid-session shows up
# without waiting for iterm-name to rename anything. Sessions outside ~/tz have no worktree there
# and get nothing. Note the node is stripped at the first space inside #(), not at " (": tmux scans
# for the ")" that closes #(), and an unbalanced "(" in the format swallows the rest of it.
set -g status-left-length 60
set -g status-left '[#{s/ \(.*//:session_name}] #(git -C "$HOME/tz/#{s/ .*//:session_name}/topaz" symbolic-ref --quiet --short HEAD 2>/dev/null) '
